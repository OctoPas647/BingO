rules_version = '2';

/* BingO for classes. The app reads and writes only what is safe here; everything else (roles, joining a class,
   the answer key, starting and grading an attempt, live control) goes through Cloud Functions (functions/index.js).
   Roles are custom claims (request.auth.token.role), set only by the functions. */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isTeacher() { return signedIn() && request.auth.token.get('role', 'student') in ['teacher', 'admin']; }
    function isAdmin() { return signedIn() && request.auth.token.get('role', 'student') == 'admin'; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function cls(cid) { return get(/databases/$(database)/documents/classes/$(cid)).data; }

    /* a profile: its owner; role and class lists are written by the functions */
    match /users/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow update: if signedIn() && me() == uid && onlyChanges(['name', 'lang', 'subjects', 'school', 'settings', 'updatedAt']);
      allow create, delete: if false;

      /* reminders and new tests for a student */
      match /inbox/{id} {
        allow read, delete: if signedIn() && me() == uid;
        allow update: if signedIn() && me() == uid && onlyChanges(['read']);
        allow create: if false;
      }
    }

    /* admin-only settings: who may become a teacher */
    match /config/{d} { allow read: if isAdmin(); allow write: if false; }
    match /schoolCodes/{c} { allow read: if isAdmin(); allow write: if false; }
    match /teacherRequests/{u} { allow read: if isAdmin() || (signedIn() && me() == u); allow write: if false; }
    match /codes/{c} { allow read, write: if false; }
    match /aiUsage/{d} { allow read, write: if false; }

    /* classes: teachers and students of the class read; teachers change the name and the look */
    match /classes/{cid} {
      allow read: if signedIn() && (me() in resource.data.teacherIds || me() in resource.data.studentIds);
      allow update: if signedIn() && me() in resource.data.teacherIds
        && onlyChanges(['name', 'subject', 'grade', 'color', 'archived', 'notes', 'calendarId', 'classroomId', 'updatedAt']);
      allow create, delete: if false;

      match /members/{uid} {
        allow read: if signedIn() && (me() == uid || me() in cls(cid).teacherIds);
        allow write: if false;
      }
    }

    /* a teacher's test bank (with the answers): only its owner and the teachers it is shared with */
    match /tests/{tid} {
      allow read, delete: if isTeacher() && (resource.data.ownerId == me() || me() in resource.data.get('sharedWith', []));
      allow create: if isTeacher() && request.resource.data.ownerId == me();
      allow update: if isTeacher() && (resource.data.ownerId == me() || me() in resource.data.get('sharedWith', []))
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    /* recurring homework: the teacher of the class */
    match /schedules/{sid} {
      allow read, delete: if isTeacher() && resource.data.ownerId == me();
      allow create: if isTeacher() && request.resource.data.ownerId == me() && me() in cls(request.resource.data.classId).teacherIds;
      allow update: if isTeacher() && resource.data.ownerId == me() && request.resource.data.ownerId == me()
        && me() in cls(request.resource.data.classId).teacherIds;
    }

    /* a planned test (0.9.0): a slot in the calendar for a class — date, subject, topics — before the test exists.
       The teacher attaches a test later; the class's students see what is coming (no tasks are in it). */
    match /plans/{pid} {
      allow read: if signedIn() && (resource.data.ownerId == me() || me() in cls(resource.data.classId).teacherIds || me() in cls(resource.data.classId).studentIds);
      allow delete: if isTeacher() && resource.data.ownerId == me();
      allow create: if isTeacher() && request.resource.data.ownerId == me() && me() in cls(request.resource.data.classId).teacherIds;
      allow update: if isTeacher() && resource.data.ownerId == me() && request.resource.data.ownerId == me()
        && me() in cls(request.resource.data.classId).teacherIds;
    }

    /* a test given to a class: the tasks inside have no answers; the key is a separate document for teachers */
    match /assignments/{aid} {
      allow read: if signedIn() && (me() in resource.data.teacherIds || me() in resource.data.studentIds);
      allow write: if false;
      match /key/{k} {
        allow read: if signedIn() && me() in resource.data.teacherIds;
        allow write: if false;
      }
    }

    /* one student's work on one assignment. Started by the startAttempt function; the student then writes
       answers and the question they are on — only while it is running, not locked, and before the deadline
       (+2 minutes for a slow connection). Quiz answers can be added, never changed.
       Leaving the test, the warnings, the device and the heartbeat are written only by the proctorReport
       function (test security), so a student cannot hide or clear them. Answers are accepted only while the
       heartbeat is alive (90 s): a page that stops reporting also stops saving. */
    match /attempts/{atid} {
      allow read: if signedIn() && (resource.data.studentId == me() || me() in resource.data.teacherIds);
      allow create, delete: if false;
      allow update: if signedIn() && resource.data.studentId == me()
        && resource.data.status == 'in_progress' && resource.data.locked != true
        && request.time < resource.data.deadline + duration.value(2, 'm')
        && (!('lastBeat' in resource.data) || resource.data.kind == 'practice' || request.time < resource.data.lastBeat + duration.value(90, 's'))
        && onlyChanges(['responses', 'current', 'answered', 'timeOn', 'lastSeen', 'quiz', 'photos', 'updatedAt', 'draft', 'practice', 'curSince'])
        && request.resource.data.quiz.diff(resource.data.quiz).changedKeys().size() == 0
        && request.resource.data.quiz.diff(resource.data.quiz).removedKeys().size() == 0;

      match /history/{h} {
        allow read: if signedIn() && (get(/databases/$(database)/documents/attempts/$(atid)).data.studentId == me()
          || me() in get(/databases/$(database)/documents/attempts/$(atid)).data.teacherIds);
        allow write: if false;
      }
    }

    /* results and the answer review: teachers always; the student once the teacher's setting allows it ("visible", set by the functions) */
    match /results/{rid} {
      allow read: if signedIn() && (me() in resource.data.teacherIds || (resource.data.studentId == me() && resource.data.visible == true));
      allow write: if false;
    }
    match /reviews/{rid} {
      allow read: if signedIn() && (me() in resource.data.teacherIds || (resource.data.studentId == me() && resource.data.visible == true));
      allow write: if false;
    }

    /* everyday BingO practice (skill map), shared with the student's teachers */
    match /progress/{uid} {
      allow read: if signedIn() && (me() == uid || me() in resource.data.get('teacherIds', []));
      allow create: if signedIn() && me() == uid && request.resource.data.get('teacherIds', []).size() == 0 && request.resource.data.get('classIds', []).size() == 0;
      allow update: if signedIn() && me() == uid
        && request.resource.data.get('teacherIds', []) == resource.data.get('teacherIds', [])
        && request.resource.data.get('classIds', []) == resource.data.get('classIds', []);
    }

    /* how a teacher grades (examples AI learns from): the teacher can see and remove them */
    match /aiExamples/{uid}/items/{id} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
