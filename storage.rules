rules_version = '2';

/* Photos of handwritten work (a student, during their own running attempt) and pictures in a teacher's questions */
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{aid}/{uid}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*')
        && firestore.get(/databases/(default)/documents/attempts/$(aid + '_' + uid)).data.status == 'in_progress';
      allow read: if request.auth != null && (request.auth.uid == uid
        || request.auth.uid in firestore.get(/databases/(default)/documents/assignments/$(aid)).data.teacherIds);
    }
    match /tests/{uid}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid && request.auth.token.get('role', 'student') in ['teacher', 'admin']
        && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
